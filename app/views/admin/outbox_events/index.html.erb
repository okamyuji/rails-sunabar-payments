<h1 class="text-2xl font-bold mb-4">Outboxモニタ</h1>
<div class="mb-4 flex gap-2">
  <%= link_to "全て", admin_outbox_events_path, class: "px-3 py-1 rounded #{params[:status].blank? ? 'bg-gray-900 text-white' : 'bg-gray-200'}" %>
  <% %w[pending sent failed].each do |s| %>
    <%= link_to s, admin_outbox_events_path(status: s), class: "px-3 py-1 rounded #{params[:status] == s ? 'bg-gray-900 text-white' : 'bg-gray-200'}" %>
  <% end %>
</div>
<table class="w-full bg-white rounded-lg shadow">
  <thead class="bg-gray-100">
    <tr>
      <th class="px-4 py-2 text-left">ID</th>
      <th class="px-4 py-2 text-left">集約</th>
      <th class="px-4 py-2 text-left">イベント種別</th>
      <th class="px-4 py-2 text-left">状態</th>
      <th class="px-4 py-2 text-left">試行</th>
      <th class="px-4 py-2 text-left">次回試行</th>
      <th class="px-4 py-2 text-left">作成日時</th>
    </tr>
  </thead>
  <tbody>
    <% @outbox_events.each do |e| %>
      <tr class="border-t hover:bg-gray-50">
        <td class="px-4 py-2"><%= link_to e.id, admin_outbox_event_path(e), class: "text-blue-600 hover:underline" %></td>
        <td class="px-4 py-2"><%= e.aggregate_type %>#<%= e.aggregate_id.to_s[0..7] %></td>
        <td class="px-4 py-2"><%= e.event_type %></td>
        <td class="px-4 py-2"><span class="px-2 py-1 rounded text-xs bg-gray-200"><%= e.status %></span></td>
        <td class="px-4 py-2"><%= e.attempt_count %>/<%= e.max_attempts %></td>
        <td class="px-4 py-2"><%= e.next_attempt_at %></td>
        <td class="px-4 py-2"><%= l(e.created_at, format: :short) rescue e.created_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
