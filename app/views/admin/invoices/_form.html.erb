<%= form_with(model: [:admin, invoice], class: "space-y-4 max-w-lg") do |f| %>
  <% if invoice.errors.any? %>
    <div class="bg-red-100 text-red-800 p-3 rounded">
      <% invoice.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <div>
    <%= f.label :virtual_account_id, "バーチャル口座ID", class: "block text-sm font-medium" %>
    <%= f.text_field :virtual_account_id, class: "w-full border rounded px-3 py-2" %>
  </div>
  <div>
    <%= f.label :amount, "請求金額(円)", class: "block text-sm font-medium" %>
    <%= f.number_field :amount, class: "w-full border rounded px-3 py-2" %>
  </div>
  <div>
    <%= f.label :description, "摘要", class: "block text-sm font-medium" %>
    <%= f.text_field :description, class: "w-full border rounded px-3 py-2" %>
  </div>
  <div>
    <%= f.label :due_date, "支払期限", class: "block text-sm font-medium" %>
    <%= f.date_field :due_date, class: "w-full border rounded px-3 py-2" %>
  </div>
  <div>
    <%= f.submit class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>
  </div>
<% end %>
