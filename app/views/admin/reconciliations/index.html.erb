<h1 class="text-2xl font-bold mb-4">消込状況</h1>
<% @virtual_accounts.each do |va| %>
  <div class="bg-white rounded-lg shadow p-4 mb-4">
    <h2 class="font-bold mb-2">VA: <%= va.va_number %> (<%= va.va_name %>)</h2>
    <div class="grid grid-cols-2 gap-4 mb-3">
      <div class="text-sm text-gray-500">請求書数: <%= va.invoices.size %></div>
      <div class="text-sm text-gray-500">入金明細数: <%= va.incoming_transactions.size %></div>
    </div>
    <% if va.invoices.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-1 text-left">請求額</th>
            <th class="px-3 py-1 text-left">入金済</th>
            <th class="px-3 py-1 text-left">状態</th>
            <th class="px-3 py-1 text-left">摘要</th>
          </tr>
        </thead>
        <tbody>
          <% va.invoices.each do |inv| %>
            <tr class="border-t">
              <td class="px-3 py-1"><%= number_with_delimiter(inv.amount) %>円</td>
              <td class="px-3 py-1"><%= number_with_delimiter(inv.paid_amount) %>円</td>
              <td class="px-3 py-1"><span class="px-2 py-0.5 rounded text-xs bg-gray-200"><%= inv.status %></span></td>
              <td class="px-3 py-1"><%= inv.description %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
